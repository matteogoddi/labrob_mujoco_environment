#!/usr/bin/env bash
set -eo pipefail
# SDK2 queries libc for the numeric Docker user during initialization. Provide a
# private account database when the host UID has no entry in the image.
uid=$(id -u)
if ! getent passwd "$uid" >/dev/null; then
  gid=$(id -g)
  identity=$(mktemp -d /tmp/g1-identity.XXXXXXXX)
  if [[ -z ${HOME:-} || $HOME == / || $HOME == /root ]]; then export HOME="$identity/home"; fi
  cp /etc/passwd "$identity/passwd"
  cp /etc/group "$identity/group"
  printf 'g1-%s:x:%s:%s:G1 operator:%s:/bin/bash\n' "$uid" "$uid" "$gid" "$HOME" >> "$identity/passwd"
  if ! getent group "$gid" >/dev/null; then
    printf 'g1-%s:x:%s:\n' "$gid" "$gid" >> "$identity/group"
  fi
  export NSS_WRAPPER_PASSWD="$identity/passwd" NSS_WRAPPER_GROUP="$identity/group"
  export LD_PRELOAD="libnss_wrapper.so${LD_PRELOAD:+:$LD_PRELOAD}"
  getent passwd "$uid" >/dev/null || { echo "Cannot resolve container UID $uid for SDK2." >&2; exit 1; }
fi
source /opt/ros/foxy/setup.bash
source /opt/unitree-ros/local_setup.bash
source /opt/g1-observer/local_setup.bash
export CMAKE_PREFIX_PATH="/opt/mujoco:${CMAKE_PREFIX_PATH:-}"
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
iface=${G1_INTERFACE:-lo}
if [[ ! $iface =~ ^[a-zA-Z0-9_.:-]+$ || ! -d /sys/class/net/$iface ]]; then
  echo "Unknown network interface: $iface" >&2
  exit 2
fi
export CYCLONEDDS_URI="<CycloneDDS><Domain><General><Interfaces><NetworkInterface name=\"$iface\"/></Interfaces></General></Domain></CycloneDDS>"
mkdir -p "$HOME"
# The short commands are symlinks to this entry point and work from any directory.
case "${0##*/}" in sim|rviz|robot|step1) set -- "${0##*/}" "$@" ;; esac
case "${1:-bash}" in
  bash)
    if [[ $# -le 1 && -t 0 && -t 1 ]]; then
      # The image runs with host numeric IDs. Skip Ubuntu's interactive sudo/group hint.
      if [[ $HOME == /tmp/g1-home ]]; then touch "$HOME/.hushlogin"; fi
      exec bash --rcfile /opt/g1/docker/interactive.bash -i
    fi
    exec bash "${@:2}" ;;
  check)
    cd /opt/g1/build
    # Run only the argument parser. The native binary must resolve its SDK DDS.
    if output=$(./main 2>&1); then exit 1; fi
    [[ $output == *"specify either"* ]]
    ldd ./main | grep 'libddsc.so' | grep -q '/usr/local/lib/'
    test -x /usr/local/bin/step1
    ldd ./g1_step1 | grep 'libddsc.so' | grep -q '/usr/local/lib/'
    python3 - <<'PYTHON'
import PyKDL
import tf2_ros
from rclpy.serialization import deserialize_message, serialize_message
from unitree_hg.msg import LowState

sample = LowState()
sample.mode_machine = 5
decoded = deserialize_message(serialize_message(sample), LowState)
assert decoded.mode_machine == 5 and len(decoded.motor_state) == 35
PYTHON
    ros2 pkg prefix rviz2
    ros2 pkg prefix g1_wbc_observer
    test -s /opt/g1-observer/lib/libg1_live_plots.so
    test -r ../g1_mj_description/stair_steps.xml
    ;;
  sim)
    shift
    [[ ${G1_SOURCE:-sim} == sim ]] || { echo "Open a simulation environment to run sim." >&2; exit 2; }
    if [[ ${G1_DEV:-0} == 1 ]]; then exec /workspace/g1/docker/dev sim "$@"; fi
    cd /opt/g1/build
    binary=./main
    if grep -qw avx2 /proc/cpuinfo && grep -qw fma /proc/cpuinfo; then binary=./main-avx2; fi
    exec "$binary" --sim --rviz "$@" ;;
  rviz)
    shift
    if [[ ${G1_DEV:-0} == 1 ]]; then exec /workspace/g1/docker/dev rviz "$@"; fi
    exec /opt/g1/scripts/run_rviz.sh "${G1_SOURCE:-sim}" "$@" ;;
  robot|step1)
    [[ ${G1_SOURCE:-sim} == robot && $iface != lo && ${ROS_DOMAIN_ID:-0} == 0 ]] || {
      echo "Use robot in a hardware environment on the G1 Ethernet interface and DDS domain 0." >&2; exit 2;
    }
    if [[ $1 == robot && $# == 2 && $2 == --mode13 ]]; then
      if [[ ${G1_DEV:-0} == 1 ]]; then exec /workspace/g1/docker/dev control; fi
      cd /opt/g1/build
      exec ./main --robot "$iface" --rviz
    fi
    [[ $# == 1 ]] || { echo "Usage: robot [--mode13]" >&2; exit 2; }
    binary=/opt/g1/build/g1_step1
    if [[ ${G1_DEV:-0} == 1 ]]; then binary=/workspace/g1/build/g1_step1; fi
    [[ -x $binary ]] || { echo "Run build in the development shell first." >&2; exit 1; }
    exec "$binary" "$iface" ;;
  *) exec "$@" ;;
esac
