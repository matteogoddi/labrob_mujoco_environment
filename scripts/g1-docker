#!/usr/bin/env bash
set -euo pipefail

image=${G1_IMAGE:-g1-experiment:foxy}
name=${G1_CONTAINER:-g1-experiment-$(id -u)}
legacy_shell=
root=$(cd "$(dirname "$0")/.." && pwd)
dev=0
if [[ ${1:-} == dev ]]; then
  shift
  dev=1
elif [[ ${1:-} == run || ${1:-} == shell ]]; then
  # A standalone distribution contains only the launcher and the image archive.
  if [[ -f "$root/CMakeLists.txt" || -e "$root/docker/dev" ]]; then
    [[ -f "$root/CMakeLists.txt" && -x "$root/docker/dev" ]] || {
      echo "Incomplete checkout at $root. Restore CMakeLists.txt and docker/dev." >&2; exit 2;
    }
    dev=1
    if [[ $1 == shell ]]; then legacy_shell="$name-shell"; fi
  fi
fi
if (( dev )); then
  if [[ -z ${G1_CONTAINER:-} ]]; then
    key=$(printf '%s' "$root" | sha256sum)
    name="${name}-${key:0:10}"
  fi
  name="${name}-dev"
fi
# Keep interactive sessions separate from persistent "up" containers.
if [[ ${1:-} == run || ${1:-} == shell ]]; then name="${name}-shell"; fi
usage() {
  cat <<'HELP'
g1-docker run sim                Open or join the interactive simulation environment
g1-docker run robot [INTERFACE]  Open or join the interactive hardware environment
Run uses the checkout beside this launcher when present. Type build inside to compile it.
A standalone launcher uses the binaries in the same image.

Image packaging and persistent container commands
g1-docker build                  Build the image from this checkout
g1-docker dev up                 Mount this source checkout for simulation development
g1-docker dev up robot INTERFACE Mount the checkout on the robot network
g1-docker dev build              Build the mounted controller and RViz observer
g1-docker dev sim|rviz           Run the development build in separate terminals
g1-docker dev control            Start the physical Mode 13 controller in a robot session
g1-docker dev exec COMMAND       Run in the checkout with the development overlay
g1-docker dev down               Remove the development container
g1-docker up sim                 Start an isolated simulation container
g1-docker up robot INTERFACE     Start a container on the robot network
g1-docker sim                    Open the MuJoCo controller in this terminal
g1-docker renderer               Print the OpenGL renderer used inside the container
g1-docker rviz [launch args]     Open RViz in a second terminal
g1-docker exec COMMAND [args]    Run a command with the container ROS environment
g1-docker down                   Stop and remove the experiment container
HELP
}

describe_session() {
  if (( dev )); then
    printf 'Image %s | checkout %s | build cache %s/build/docker-dev\n' "$1" "$root" "$root"
    if [[ ! -x "$root/build/docker-dev/main" || ! -x "$root/build/docker-dev/g1_step1" || ! -r "$root/build/docker-dev/ros2/install/local_setup.bash" ]]; then
      echo "First use: type build in one container terminal before starting the applications."
    fi
  else
    printf 'Image %s | packaged binaries in /opt/g1/build\n' "$1"
  fi
}

# Docker reserves a container name before its first shell starts. A concurrent
# terminal can observe that brief "created" state before docker exec is ready.
join_session() {
  local info id state label nic checkout running_image attempt
  for attempt in {1..30}; do
    info=$(docker container inspect --format '{{.Id}}|{{.State.Status}}|{{index .Config.Labels "io.g1.session"}}|{{index .Config.Labels "io.g1.interface"}}|{{index .Config.Labels "io.g1.checkout"}}|{{.Config.Image}}' "$name" 2>/dev/null) || return 1
    IFS='|' read -r id state label nic checkout running_image <<< "$info"
    if [[ $label != "$source_mode" || (-n $iface && $iface != "$nic") || ($dev == 1 && $checkout != "$root") ]]; then
      echo "Container $name belongs to another configuration. Check the interface, checkout or G1_CONTAINER." >&2
      exit 2
    fi
    case $state in
      running) describe_session "$running_image"; exec docker exec -it "$id" g1-env bash ;;
      created) sleep 0.1 ;;
      *) echo "Container $name is $state. Check it with docker ps -a." >&2; exit 1 ;;
    esac
  done
  echo "Container $name is still starting. Repeat the same run command." >&2
  exit 1
}

robot_interface() {
  local path nic
  local wired=() active=()
  for path in /sys/class/net/*; do
    [[ -e $path/device && ! -d $path/wireless && ! -e $path/phy80211 && $(<"$path/type") == 1 ]] || continue
    nic=${path##*/}
    wired+=("$nic")
    if [[ $(<"$path/operstate") == up ]]; then active+=("$nic"); fi
  done
  if (( ${#active[@]} == 1 )); then
    printf '%s\n' "${active[0]}"
  elif (( ${#wired[@]} == 1 )); then
    printf '%s\n' "${wired[0]}"
  else
    echo "Select the G1 Ethernet interface from ip -br addr and use: g1-docker run robot INTERFACE" >&2
    return 2
  fi
}

# Test the same type of OpenGL context used by MuJoCo. The probe uses a
# hidden window and an isolated network even when preparing a robot shell.
renderer_probe='
import ctypes as c
glfw = c.CDLL("libglfw.so.3")
gl = c.CDLL("libGL.so.1")
if not glfw.glfwInit():
    raise SystemExit("GLFW could not open the container display")
glfw.glfwWindowHint(0x00020004, 0)  # GLFW_VISIBLE
glfw.glfwCreateWindow.restype = c.c_void_p
window = glfw.glfwCreateWindow(16, 16, b"Renderer check", None, None)
if not window:
    raise SystemExit("Could not create an OpenGL context")
glfw.glfwMakeContextCurrent(c.c_void_p(window))
gl.glGetString.restype = c.c_char_p
print(gl.glGetString(0x1F01).decode())
glfw.glfwTerminate()'

probe_gl() {
  docker run --rm --network none --user "$(id -u):$(id -g)" --env HOME=/tmp/g1-home \
    "${graphics[@]}" "$@" --entrypoint python3 "$image" -c "$renderer_probe"
}

case "${1:-help}" in
  build)
    if (( dev )); then
      exec docker exec "$name" /workspace/g1/docker/dev build
    fi
    exec docker build --tag "$image" "$root" ;;
  up|run)
    action=$1
    if [[ $action == run && $# == 1 ]]; then set -- run sim; fi
    mounts=()
    if (( dev )); then
      [[ -f "$root/CMakeLists.txt" && -x "$root/docker/dev" ]] || {
        echo "Run g1-docker dev up from a source checkout." >&2; exit 2;
      }
      mkdir -p "$root/build/docker-dev"
      mounts+=(--volume "$root:/workspace/g1" --volume "$root/build/docker-dev:/workspace/g1/build"
               --workdir /workspace/g1 --env G1_DEV=1)
      if [[ $# == 1 ]]; then set -- "$action" sim; fi
    fi
    source_mode=${2:-}
    case "$source_mode" in
      sim) [[ $# == 2 ]] || { usage >&2; exit 2; }; iface=lo; network=none ;;
      robot)
        iface=${3:-}
        if [[ $action == run && $# == 2 ]]; then
          iface=${G1_INTERFACE:-}
        elif [[ $# != 3 || -z $iface ]]; then
          usage >&2; exit 2
        fi
        if [[ -n $iface && ( ! $iface =~ ^[a-zA-Z0-9_.:-]+$ || $iface == lo || ! -d /sys/class/net/$iface ) ]]; then
          echo 'Specify the robot Ethernet interface shown by ip -br addr.' >&2
          exit 2
        fi
        network=host ;;
      *) usage >&2; exit 2 ;;
    esac
    if [[ $action == run ]]; then
      name="${name}-$source_mode"
      join_session || :
      if [[ -z $iface ]]; then iface=$(robot_interface); fi
    fi
    if (( dev )) && ! docker image inspect "$image" >/dev/null 2>&1; then
      docker build --tag "$image" "$root"
    fi
    options=(--init --name "$name" --label io.g1.experiment=true
             --network "$network" --hostname "$(hostname)" --user "$(id -u):$(id -g)"
             --env HOME=/tmp/g1-home
             --env "G1_INTERFACE=$iface" --env "G1_SOURCE=$source_mode"
             --env "ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}")
    graphics=()
    gpu=${G1_NVIDIA:-auto}
    case "$gpu" in auto|0|1) ;; *) echo "G1_NVIDIA must be auto, 0 or 1." >&2; exit 2 ;; esac
    wslg=0
    if [[ -d /mnt/wslg && -d /mnt/wslg/.X11-unix ]]; then wslg=1; fi
    if [[ -n ${DISPLAY:-} ]]; then
      socket=/tmp/.X11-unix
      if (( wslg )); then socket=/mnt/wslg/.X11-unix; fi
      [[ -d $socket ]] || { echo "Missing X11 socket directory: $socket" >&2; exit 2; }
      graphics+=(--env DISPLAY --env QT_X11_NO_MITSHM=1 --volume "$socket:/tmp/.X11-unix:ro")
      auth=${XAUTHORITY:-$HOME/.Xauthority}
      if [[ -f $auth && -r $auth ]]; then
        graphics+=(--env XAUTHORITY=/tmp/g1.xauth --volume "$auth:/tmp/g1.xauth:ro")
      elif (( ! wslg )); then
        echo 'A readable XAUTHORITY file is required for the local X11/XWayland session.' >&2; exit 2
      fi
    fi

    # Pass the actual render-node group IDs, which vary between workstations.
    mesa_pci=
    for device in /dev/dri/renderD*; do
      if [[ -c $device ]]; then
        graphics+=(--device "$device" --group-add "$(stat -c %g "$device")")
        pci_dir=/sys/class/drm/${device##*/}/device
        if [[ -r $pci_dir/vendor && $(<"$pci_dir/vendor") =~ ^0x(8086|1002)$ ]]; then
          address=$(basename "$(readlink -f "$pci_dir")")
          if [[ $address =~ ^[[:xdigit:]]{4}:[[:xdigit:]]{2}:[[:xdigit:]]{2}\.[0-7]$ ]] &&
              [[ -z $mesa_pci || ( -r $pci_dir/boot_vga && $(<"$pci_dir/boot_vga") == 1 ) ]]; then
            mesa_pci="pci-${address//[:.]/_}"
          fi
        fi
      fi
    done
    nvidia=()
    if (( wslg )); then
      if [[ -c /dev/dxg && -d /usr/lib/wsl/lib ]]; then
        graphics+=(--device /dev/dxg --group-add "$(stat -c %g /dev/dxg)"
                   --volume /usr/lib/wsl:/usr/lib/wsl:ro --env LD_LIBRARY_PATH=/usr/lib/wsl/lib)
        nvidia=(--env MESA_D3D12_DEFAULT_ADAPTER_NAME=NVIDIA)
      fi
    elif [[ $gpu == 1 || ( $gpu == auto && -c /dev/nvidiactl ) ]] ||
        { [[ $gpu == auto ]] && command -v nvidia-smi >/dev/null && nvidia-smi -L >/dev/null 2>&1; }; then
      nvidia=(--gpus all --env NVIDIA_DRIVER_CAPABILITIES=graphics,display,utility,compute)
    fi

    renderer=
    if [[ -n ${DISPLAY:-} ]]; then
      if [[ $gpu != 0 && ${#nvidia[@]} -gt 0 ]]; then
        renderer=$(probe_gl "${nvidia[@]}") || renderer=
        if (( ! wslg )) && [[ ${renderer,,} != *nvidia* ]]; then
          nvidia+=(--env __NV_PRIME_RENDER_OFFLOAD=1 --env __GLX_VENDOR_LIBRARY_NAME=nvidia)
          renderer=$(probe_gl "${nvidia[@]}") || renderer=
        fi
        if [[ ${renderer,,} == *nvidia* ]]; then
          graphics+=("${nvidia[@]}")
        else
          renderer=
        fi
      fi
      if [[ -z $renderer ]]; then
        if [[ $gpu == 1 ]]; then echo 'The OpenGL probe could not select NVIDIA.' >&2; exit 1; fi
        if (( ! wslg )); then
          graphics+=(--env __GLX_VENDOR_LIBRARY_NAME=mesa)
          if [[ -n $mesa_pci ]]; then
            if renderer=$(probe_gl --env "DRI_PRIME=$mesa_pci") &&
                [[ -n $renderer && ${renderer,,} != *llvmpipe* && ${renderer,,} != *softpipe* ]]; then
              graphics+=(--env "DRI_PRIME=$mesa_pci")
            else
              renderer=
            fi
          fi
        fi
        [[ -n $renderer ]] || renderer=$(probe_gl) || { echo 'Could not open an OpenGL window. Check the display socket and driver.' >&2; exit 1; }
      fi
      echo "OpenGL renderer: $renderer"
      case "${renderer,,}" in *llvmpipe*|*softpipe*|*swrast*|*basic\ render*)
        echo "Software rendering is active. Check the host graphics setup for real-time use." >&2 ;;
      esac
    elif [[ $gpu != 0 && ${#nvidia[@]} -gt 0 ]]; then
      # Headless observation does not require an OpenGL context.
      if (( wslg )) || [[ $gpu == 1 ]] ||
          [[ $(docker info --format '{{if index .Runtimes "nvidia"}}yes{{end}}') == yes ]]; then
        graphics+=("${nvidia[@]}")
      fi
    fi
    options+=("${graphics[@]}")
    data=${G1_DATA:-$PWD/experiments}
    mkdir -p "$data"
    options+=(--volume "$(cd "$data" && pwd):/opt/g1/experiments")
    if (( dev )); then options+=(--volume "$(cd "$data" && pwd):/workspace/g1/experiments"); fi
    if [[ $action == run ]]; then
      options+=(--label "io.g1.session=$source_mode" --label "io.g1.interface=$iface")
      if (( dev )); then options+=(--label "io.g1.checkout=$root"); fi
      # If two terminals create the same session together, the loser joins the winner.
      describe_session "$image"
      result=0
      docker run --rm -it "${mounts[@]}" "${options[@]}" "$image" bash || result=$?
      if (( result == 125 )); then join_session || :; fi
      exit "$result"
    fi
    exec docker run --detach "${mounts[@]}" "${options[@]}" "$image" sleep infinity ;;
  shell)
    # Compatibility with the previous shared name and with a single new session.
    sessions=()
    candidates=("$name" "$name-sim" "$name-robot")
    if [[ -n $legacy_shell ]]; then candidates+=("$legacy_shell" "$legacy_shell-sim" "$legacy_shell-robot"); fi
    for candidate in "${candidates[@]}"; do
      if [[ $(docker container inspect --format '{{.State.Running}} {{index .Config.Labels "io.g1.experiment"}}' "$candidate" 2>/dev/null) == 'true true' ]]; then
        sessions+=("$candidate")
      fi
    done
    if (( ${#sessions[@]} != 1 )); then
      echo "Choose a session with run sim or run robot." >&2; exit 1
    fi
    exec docker exec -it "${sessions[0]}" g1-env bash ;;
  sim|rviz|renderer|exec|control|down)
    if [[ $(docker inspect --type container --format '{{index .Config.Labels "io.g1.experiment"}}' "$name") != true ]]; then
      echo "Start an experiment container with g1-docker up first." >&2
      exit 1
    fi
    action=$1
    shift
    if [[ $action == down ]]; then
      docker stop "$name" >/dev/null
      exec docker rm "$name"
    fi
    if [[ $action == sim && $(docker inspect --format '{{.HostConfig.NetworkMode}}' "$name") != none ]]; then
      echo 'Start a simulation container with g1-docker up sim.' >&2
      exit 2
    fi
    tty=()
    [[ -t 0 && -t 1 ]] && tty=(-it)
    if [[ $action == renderer ]]; then
      exec docker exec "$name" python3 -c "$renderer_probe"
    fi
    if (( dev )); then
      exec docker exec "${tty[@]}" "$name" /workspace/g1/docker/dev "$action" "$@"
    fi
    if [[ $action == control ]]; then usage >&2; exit 2; fi
    if [[ $action != exec ]]; then set -- "$action" "$@"; fi
    [[ $# -gt 0 ]] || { usage >&2; exit 2; }
    exec docker exec "${tty[@]}" "$name" /usr/local/bin/g1-env "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
